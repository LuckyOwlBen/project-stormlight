# Database (or set DATABASE_URL to a full connection string instead of the POSTGRES_* values)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=stormlight
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stormlight
POSTGRES_SCHEMA=public
# Use "require" (or stricter) for hosted databases
POSTGRES_SSLMODE=disable

# Secret that signs session cookies. Generate a long random value, e.g. `openssl rand -hex 32`.
# If unset a random key is used and everyone is logged out on every restart.
SESSION_SECRET=fake-session-secret-for-development

# Set to true when serving over HTTPS so the session cookie is only sent encrypted
COOKIE_SECURE=false

# Required to register a GM account at /register/gm
GM_SECRET=change-me

# Port to listen on (default 3000)
PORT=3000

# Extra hosts allowed to open WebSocket connections, comma separated (same host is always allowed)
ALLOWED_ORIGINS=
