package views

import (
    "project-stormlight/internal/models"
    "strconv"
    "project-stormlight/internal/store"
)

templ DashboardRoot() {
    @Layout("GM Dashboard", true) {
        <div
        hx-ext="ws"
        ws-connect="/gm/ws"
        hx-swap="innerHTML"
        >
            <div class="container mx-auto p-4 max-w-6xl">
                <!-- Content Area -->
                <div class="tabs tabs-lift tabs-bottom mb-6 justify-center">
                    // Overview Tab
                    <input type="radio" name="gm_tabs" class="tab" aria-label="Overview" checked="checked"/>
                    <div class="tab-content bg-base-100 border-base-300 p-6">
                        @DashboardOverview()
                    </div>

                    // Sessions Tab
                    <input type="radio" name="gm_tabs" class="tab" aria-label="Sessions" />
                    <div class="tab-content bg-base-100 border-base-300 p-6">
                        <div id="activeSessions" hx-swap-oob="true">
                            @ActiveSessionsComponent([]models.PlayerInfo{})
                        </div>
                    </div>

                    // Combat Tab
                    <div hx-get="/combat/tracker" hx-trigger="load" hx-swap-oob="true"></div>
                    <input type="radio" name="gm_tabs" class="tab" aria-label="Combat" />
                    <div class="tab-content bg-base-100 border-base-300 p-6">
                        <div id="combatTracker" hx-swap-oob="true">
                            @CombatTracker(models.CombatTrackerData{})
                        </div>
                    </div>

                    // Store Management Tab
                    <input type="radio" name="gm_tabs" class="tab" aria-label="Store Management" />
                    <div class="tab-content bg-base-100 border-base-300 p-6">
                        @StoreManagementComponent()
                    </div>
                </div>
            </div>
        </div>
    }
}

templ DashboardOverview() {
    <div class="text-center py-10">
        <h2 class="text-2xl font-bold text-primary">Welcome to the GM Dashboard</h2>
        <p class="opacity-70">Select a tab above to manage your sessions and world info.</p>
    </div>
}


templ ActiveSessionsComponent(p []models.PlayerInfo) {
    <!-- Connected Players -->
	<div class="card bg-base-200 shadow-xl">
		<div class="card-body">
			<h2 class="card-title flex justify-between items-center">
				<span>Connected Players</span>
				<div class="badge badge-accent" id="gm-player-count">0</div>
			</h2>
            if len(p) > 0 {
                for _, player := range p {
                <div class="flex items-center justify-between gap-3 p-2 rounded bg-base-100 w-full">
					<div class="flex items-center gap-2">
						<div class="badge badge-success badge-xs"></div>
						<span class="font-medium"> {player.CharName} </span>
                        <div class="flex items-center gap-2">
                            <span class="font-bold text-sm">HP:</span>
                            <progress class="progress progress-error w-full" value={ strconv.Itoa(player.CurrentHp) } max={ strconv.Itoa(player.MaxHp) }></progress>
                            <span class="text-xs font-semibold px-2 py-1 bg-error/10 text-error rounded-md">{ player.CurrentHp } / { player.MaxHp }</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="font-bold text-sm">Focus:</span>
                            <progress class="progress progress-info w-full" value={ strconv.Itoa(player.CurrentFocus) } max={ strconv.Itoa(player.MaxFocus) }></progress>
                            <span class="text-xs font-semibold px-2 py-1 bg-info/10 text-info rounded-md">{ player.CurrentFocus } / { player.MaxFocus }</span>
                        </div>
                        <div hidden={ !player.IsInvested } class="flex items-center gap-2">
                            <span class="font-bold text-sm">Invested:</span>
                            <progress class="progress progress-success w-full" value={ strconv.Itoa(player.CurrentInvest) } max={ strconv.Itoa(player.MaxInvest) }></progress>
                            <span class="text-xs font-semibold px-2 py-1 bg-success/10 text-success rounded-md">{ player.CurrentInvest } / { player.MaxInvest }</span>
                        </div>
						<span class="text-xs font-semibold bg-primary/10 text-primary px-2 py-0.5 rounded">Lvl {player.Level}</span>
					</div>
                    //have to pre load the modal content to avoid issues with htmx and modals
                    <div hx-get={"/gm/store/grant-item-modal?playerId=" + strconv.Itoa(player.CharID)} hx-trigger="load" hx-target="body" hx-swap="beforeend"></div>
                    <div hx-get={"/gm/spren-grant-modal?charId=" + strconv.Itoa(player.CharID)} hx-trigger="load" hx-target="body" hx-swap="beforeend"></div>
                    <button class="btn btn-xs btn-primary font-bold ml-auto" onclick="document.getElementById('grant-spren-modal').showModal()">Grant Spren</button>
                    <button class="btn btn-xs btn-primary font-bold ml-auto" onclick="document.getElementById('grant-item-modal').showModal()">Grant Item</button> 
					<button class="btn btn-xs btn-primary font-bold ml-auto" hx-post={"/characters/" + strconv.Itoa(player.CharID) + "/level-up"} hx-swap="none">Level Up</button>
				</div>
                }
            } else {
                <div id="gm-player-list" class="space-y-2 mt-2">
				    <p class="text-base-content/50 text-sm italic">No players connected yet.</p>
			    </div>
            }
		</div>
    </div>
}

templ CombatTracker(data models.CombatTrackerData) {
    <div class="card bg-base-200 shadow-xl">
        <div class="card-body">
            <h2 class="card-title mb-2">Combat Tracker</h2>
            if data.ActiveSession != nil {
                @ActiveCombat(data)
            } else {
                @PlanMode(data)
            }
        </div>
    </div>
}

templ PlanMode(data models.CombatTrackerData) {
    <div class="flex justify-between items-center mb-4">
        <span class="badge badge-outline">Planning</span>
        <button class="btn btn-success btn-sm" hx-post="/combat/session/create" hx-swap="none">
            Create Session
        </button>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card bg-base-200 border border-base-300 shadow-sm">
            <div class="card-body p-3">
                <h3 class="font-bold text-sm mb-2">Sessions</h3>
                <div class="max-h-48 overflow-y-auto space-y-2 pr-1">
                    for _, session := range data.Sessions {
                        if !session.Active {
                            <div class="flex items-center justify-between p-3 bg-base-100 rounded-lg shadow-sm border border-base-300">
                                <div>
                                    <div class="font-bold text-sm">Session #{ strconv.Itoa(session.ID) }</div>
                                    <div class="text-xs opacity-60">{ strconv.Itoa(len(session.Participants)) } players · { strconv.Itoa(len(session.SessionEnemies)) } enemies</div>
                                </div>
                                <div class="flex gap-1">
                                    <button class="btn btn-success btn-xs"
                                        hx-post={ "/combat/session/" + strconv.Itoa(session.ID) + "/start" }
                                        hx-swap="none">
                                        Start Combat
                                    </button>
                                    <form hx-post="/combat/session/end" hx-swap="none">
                                        <input type="hidden" name="sessionId" value={ strconv.Itoa(session.ID) } />
                                        <button type="submit" class="btn btn-error btn-xs">End Session</button>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                    if len(data.Sessions) == 0 {
                        <p class="text-base-content/50 text-sm italic">No sessions yet.</p>
                    }
                </div>
            </div>
        </div>
        <div class="card bg-base-200 border border-base-300 shadow-sm">
            <div class="card-body p-3">
                <h3 class="font-bold text-sm mb-2">Enemy Archive</h3>
                @EnemyArchiveList(data.ArchiveEnemies, data.PlanningSession)
                @AddEnemyToArchiveForm()
            </div>
        </div>
        if data.PlanningSession != nil {
            <div class="card bg-base-200 border border-base-300 shadow-sm">
                <div class="card-body p-3">
                    <h3 class="font-bold text-sm mb-2">Session Enemies</h3>
                    @SessionEnemyList(data.PlanningSession.SessionEnemies, data.PlanningSession.ID)
                </div>
            </div>
        }
        <div class="card bg-base-200 border border-base-300 shadow-sm">
            <div class="card-body p-3">
                if len(data.PaceEntries) > 0 {
                    <h3 class="font-bold text-sm mb-2">Pace Roll-Call</h3>
                    <div class="max-h-48 overflow-y-auto pr-1">
                        @PaceRollCall(data.PaceEntries)
                    </div>
                } else {
                    <h3 class="font-bold text-sm mb-2">Connected Players</h3>
                    <div class="max-h-48 overflow-y-auto pr-1">
                        @PlayerList(data.SessionPlayers)
                    </div>
                }
            </div>
        </div>
    </div>
}

templ ActiveCombat(data models.CombatTrackerData) {
    <div class="flex justify-between items-center mb-4">
        <span class="badge badge-error">⚔ Active Combat — Session #{ strconv.Itoa(data.ActiveSession.ID) }</span>
        <div class="flex gap-2">
            <button class="btn btn-primary btn-sm"
                hx-post={ "/combat/session/" + strconv.Itoa(data.ActiveSession.ID) + "/next-turn" }
                hx-swap="none">
                Next Turn
            </button>
            <button class="btn btn-warning btn-sm"
                hx-post={ "/combat/session/" + strconv.Itoa(data.ActiveSession.ID) + "/end-combat" }
                hx-swap="none">
                End Combat
            </button>
        </div>
    </div>
    if data.RoundPending {
        <div class="alert alert-warning mb-4">
            <span>⏳ Awaiting pace selection — round begins when all players respond.</span>
        </div>
        @PaceRollCall(data.PaceEntries)
    } else {
        <div class="grid grid-cols-2 gap-4">
            @TurnGroupPanel("Fast Players", data.FastPlayers, data.ActiveSession.ID, false)
            @TurnGroupPanel("Fast NPCs", data.FastNPCs, data.ActiveSession.ID, true)
            @TurnGroupPanel("Slow Players", data.SlowPlayers, data.ActiveSession.ID, false)
            @TurnGroupPanel("Slow NPCs", data.SlowNPCs, data.ActiveSession.ID, true)
        </div>
    }
}

templ TurnGroupPanel(title string, entries []models.TurnEntry, sessionID int, isEnemy bool) {
    <div class="card bg-base-100 shadow border border-base-300">
        <div class="card-body p-3">
            <h3 class="font-bold text-sm mb-2">{ title }</h3>
            <div class="max-h-48 overflow-y-auto space-y-1">
                for _, entry := range entries {
                    <div class={ "flex items-center justify-between p-2 rounded", templ.KV("bg-primary/20 ring-1 ring-primary", entry.IsCurrent) }>
                        <div class="flex items-center gap-2">
                            if entry.IsCurrent {
                                <span class="text-primary font-bold text-xs">▶</span>
                            }
                            <span class="text-sm font-medium">{ entry.Name }</span>
                            <span class="text-xs opacity-60">{ strconv.Itoa(entry.CurrentHP) }/{ strconv.Itoa(entry.MaxHP) } HP</span>
                        </div>
                        if isEnemy {
                            <div class="flex items-center gap-1">
                                <button class="btn btn-xs btn-outline"
                                    hx-post={ "/combat/session-enemy/" + strconv.Itoa(entry.EnemyID) + "/hp/increment" }
                                    hx-swap="none">+</button>
                                <button class="btn btn-xs btn-outline"
                                    hx-post={ "/combat/session-enemy/" + strconv.Itoa(entry.EnemyID) + "/hp/decrement" }
                                    hx-swap="none">-</button>
                                <button class="btn btn-xs btn-error"
                                    hx-post={ "/combat/session-enemy/" + strconv.Itoa(entry.EnemyID) + "/remove" }
                                    hx-swap="none">✕</button>
                            </div>
                        }
                    </div>
                }
                if len(entries) == 0 {
                    <p class="text-xs opacity-40 italic">None</p>
                }
            </div>
        </div>
    </div>
}

templ EnemyArchiveList(enemies []models.Enemy, planningSession *models.CombatSession) {
    <div class="max-h-48 overflow-y-auto space-y-2 pr-1">
        for _, enemy := range enemies {
            <div class="flex items-center justify-between p-3 bg-base-100 rounded-lg shadow-sm border border-base-300">
                <div>
                    <div class="font-bold text-sm">{ enemy.Name }</div>
                    <div class="text-xs opacity-60">HP: { strconv.Itoa(enemy.HP) } · { enemy.Mode }</div>
                </div>
                <div class="flex items-center gap-1">
                    if planningSession != nil {
                        <button class="btn btn-xs btn-success"
                            hx-post={ "/combat/session/" + strconv.Itoa(planningSession.ID) + "/enemy/add" }
                            hx-vals={ `{"templateId":"` + strconv.Itoa(enemy.ID) + `"}` }
                            hx-swap="none">
                            + Session
                        </button>
                    }
                    <form hx-post="/combat/enemy/remove" hx-swap="none">
                        <input type="hidden" name="enemyId" value={ strconv.Itoa(enemy.ID) } />
                        <button type="submit" class="btn btn-error btn-xs">✕</button>
                    </form>
                </div>
            </div>
        }
        if len(enemies) == 0 {
            <p class="text-base-content/50 text-sm italic">Archive is empty.</p>
        }
    </div>
}

templ SessionEnemyList(enemies []models.CombatSessionEnemy, sessionID int) {
    <div class="max-h-48 overflow-y-auto space-y-2 pr-1">
        for _, se := range enemies {
            <div class="flex items-center justify-between p-3 bg-base-100 rounded-lg shadow-sm border border-base-300">
                <div>
                    <div class="font-bold text-sm">{ se.EnemyName }</div>
                    <div class="text-xs opacity-60">HP: { strconv.Itoa(se.CurrentHP) }/{ strconv.Itoa(se.MaxHP) }</div>
                </div>
                <div class="flex items-center gap-1">
                    <button class={ "btn btn-xs", templ.KV("btn-accent", se.Mode == "fast") }
                        hx-post={ "/combat/session-enemy/" + strconv.Itoa(se.ID) + "/pace/fast" }
                        hx-swap="none">Fast</button>
                    <button class={ "btn btn-xs", templ.KV("btn-secondary", se.Mode == "slow") }
                        hx-post={ "/combat/session-enemy/" + strconv.Itoa(se.ID) + "/pace/slow" }
                        hx-swap="none">Slow</button>
                    <button class="btn btn-xs btn-error"
                        hx-post={ "/combat/session-enemy/" + strconv.Itoa(se.ID) + "/remove" }
                        hx-swap="none">✕</button>
                </div>
            </div>
        }
        if len(enemies) == 0 {
            <p class="text-base-content/50 text-sm italic">No enemies in this session.</p>
        }
    </div>
}

templ AddEnemyToArchiveForm() {
    <form hx-post="/combat/enemy/add" hx-swap="none" class="mt-3 space-y-2">
        <input type="text" name="name" placeholder="Enemy Name" class="input input-bordered input-sm w-full" required />
        <div class="flex gap-2">
            <input type="number" name="hp" placeholder="HP" class="input input-bordered input-sm w-1/2" required />
            <select name="mode" class="select select-bordered select-sm w-1/2">
                <option value="fast">Fast</option>
                <option value="slow">Slow</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary btn-sm w-full">Add to Archive</button>
    </form>
}

templ PlayerList(players []models.PlayerInfo) {
    <div class="space-y-2">
        for _, player := range players {
            <div class="flex items-center justify-between p-3 bg-base-100 rounded-lg shadow-sm border border-base-300">
                <div>
                    <div class="font-bold text-sm">{ player.CharName }</div>
                    <div class="text-xs opacity-60">HP: { strconv.Itoa(player.CurrentHp) } / { strconv.Itoa(player.MaxHp) }</div>
                </div>
            </div>
        }
        if len(players) == 0 {
            <p class="text-base-content/50 text-sm italic">No players connected.</p>
        }
    </div>
}

templ PaceRollCall(entries []models.PaceRollCallEntry) {
    <div class="space-y-2">
        for _, entry := range entries {
            <div class="flex items-center justify-between p-3 bg-base-100 rounded-lg shadow-sm border border-base-300">
                <div class="font-bold text-sm">{ entry.CharName }</div>
                if entry.Mode == "Fast" {
                    <div class="badge badge-accent">Fast</div>
                } else if entry.Mode == "Slow" {
                    <div class="badge badge-secondary">Slow</div>
                } else {
                    <div class="badge badge-ghost">Pending...</div>
                }
            </div>
        }
        if len(entries) == 0 {
            <p class="text-base-content/50 text-sm italic">No players enrolled.</p>
        }
    </div>
}

templ CombatPaceChoiceButtons(characterID int) {
    <div class="flex justify-center gap-3 mt-2">
        <button
            class="btn btn-accent btn-sm"
            hx-post={ "/characters/" + strconv.Itoa(characterID) + "/combat/pace/fast" }
            hx-target="#eventModal"
            hx-swap="innerHTML">
            Fast
        </button>
        <button
            class="btn btn-secondary btn-sm"
            hx-post={ "/characters/" + strconv.Itoa(characterID) + "/combat/pace/slow" }
            hx-target="#eventModal"
            hx-swap="innerHTML">
            Slow
        </button>
    </div>
}

templ StoreManagementComponent() {
    <!-- Store Management -->
    <div class="card bg-base-200 shadow-xl">
        <div class="card-body">
            <h2 class="card-title mb-4 flex justify-between items-center">
                <span>Store Management</span>
            </h2>
            <div id="store-controls-container" hx-get="/gm/store/controls" hx-trigger="load, store-updated" hx-swap="innerHTML">
                <p class="text-base-content/50 text-sm italic">Loading store controls...</p>
            </div>
        </div>
    </div>
}

templ GMStoreControls(storeState *models.StoreState) {
	<div class="space-y-6">
		<!-- Global Switches -->
		<div class="p-4 bg-base-100 rounded-xl space-y-4 border border-base-300">
			<!-- Toggle Selling -->
			<div class="flex items-center justify-between">
				<div>
					<div class="font-bold text-sm">Allow Player Selling</div>
					<div class="text-xs opacity-60">Let players sell items back to the store</div>
				</div>
				<form hx-post="/gm/store/toggle-sell" hx-target="#store-controls-container" hx-swap="innerHTML" class="inline">
					<input 
						type="checkbox" 
						class="toggle toggle-success" 
						if storeState.CanSell { checked } onChange="this.form.dispatchEvent(new Event('submit'))"/>
				</form>
			</div>

			<!-- Sell Percentage Adjuster -->
			<div class="pt-2">
				<div class="flex justify-between items-center mb-1">
					<span class="font-bold text-sm">Sell Back Percentage</span>
					<span class="text-xs font-semibold px-2 py-1 bg-success/10 text-success rounded-md">{ strconv.Itoa(storeState.SellPercentage) }% of original</span>
				</div>
				<form hx-post="/gm/store/update-sell-percentage" hx-target="#store-controls-container" hx-swap="innerHTML" class="flex items-center gap-3">
					<input 
						type="range" 
						name="sellPercentage"
						min="0" 
						max="100" 
						value={ strconv.Itoa(storeState.SellPercentage) } 
						class="range range-success range-sm flex-1" 
						onchange="this.form.dispatchEvent(new Event('submit'))"
					/>
				</form>
			</div>
		</div>

		<!-- Category Lockers Section -->
		<div>
			<h3 class="font-bold text-sm mb-3">Segment Control</h3>
			<div class="space-y-2 max-h-[350px] overflow-y-auto pr-1">
				for _, sec := range storeState.Sections {
					<div class="flex items-center justify-between p-3 bg-base-100 rounded-lg shadow-sm border border-base-300">
						<div>
							<div class="font-bold text-sm">{ sec.Name }</div>
							<div class="text-xs opacity-60 truncate max-w-[200px]">{ sec.Code }</div>
						</div>
						<div class="flex items-center gap-3">
							if sec.IsOpen {
								<span class="badge badge-success badge-sm">Open</span>
								<form hx-post="/gm/store/toggle-section" hx-target="#store-controls-container" hx-swap="innerHTML">
									<input type="hidden" name="code" value={ sec.Code } />
									<button type="submit" class="btn btn-warning btn-xs flex items-center gap-1">
										<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-3.5 h-3.5 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"></path></svg>
										Lock
									</button>
								</form>
							} else {
								<span class="badge badge-neutral badge-sm opacity-60">Locked</span>
								<form hx-post="/gm/store/toggle-section" hx-target="#store-controls-container" hx-swap="innerHTML">
									<input type="hidden" name="code" value={ sec.Code } />
									<button type="submit" class="btn btn-success btn-xs btn-outline flex items-center gap-1">
										<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-3.5 h-3.5 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"></path></svg>
										Unlock
									</button>
								</form>
							}
						</div>
					</div>
				}
			</div>
		</div>
	</div>
}

templ GrantItemModal(playerId int, itemMap map[string][]store.Item) {
    <dialog id="grant-item-modal" class="modal">
        <div class="modal-box relative max-w-2xl">
            <input type="hidden" name="playerId" value={ strconv.Itoa(playerId) } />
            <div class="card bg-base-100 shadow p-4">            
                <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" onclick="document.getElementById('grant-item-modal').close()">✕</button>
                <h3 class="text-lg font-bold mb-4 text-center">Grant Item to Player</h3>
                <div class="tabs tabs-lift tabs-bottom mb-6 justify-center">
                    for category := range itemMap {
                        <input type="radio" name="category" class="tab" aria-label={ category } checked={ category == "armorItems" } />
                        <div class="tab-content bg-base-100 border-base-300 p-6" style="max-height: 40rem; overflow-y: auto;">
                            <div class=" grid grid-cols-3 gap-3 max-h-100 overflow-y-auto pr-2">
                                for _, item := range itemMap[category] {
                                    <form hx-post="/gm/store/grant-item" hx-swap="none">
                                        <input type="hidden" name="playerId" value={ strconv.Itoa(playerId) } />
                                        <input type="hidden" name="itemId" value={ item.Id } />
                                        <div class="card bg-base-200 shadow p-4">
                                            <span class="font-medium">{ item.Name }</span>
                                            <span>
                                                <label class="block text-sm font-medium mt-2 mb-1">Quantity</label>
                                                <input type="number" name="quantity" min="1" value="1" class="input input-bordered w-full" required />
                                            </span>
                                            <div class="modal-action mt-3">
                                                <button type="submit" class="btn btn-primary btn-sm">Grant Item</button>
                                            </div>
                                        </div>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </dialog>
}

templ SprenGrantForm(playerId int, sprenList []string) {
    <dialog id="grant-spren-modal" class="modal">
        <div class="modal-box relative max-w-2xl">
            if (len(sprenList) == 0) {
                <div class="text-center py-10">
                    <h2 class="text-lg font-bold text-primary">No Spren Available</h2>
                    <p class="opacity-70">This player already has a bond.</p>
                </div>
            } else {
                <form hx-post="/gm/grant-spren" hx-swap="none" class="space-y-4">
                    <input type="hidden" name="playerId" value={ strconv.Itoa(playerId) } />
                    <div>{playerId}</div>
                    <div class="form-control w-full">
                        <label class="label">
                            <span class="label-text">Select Spren</span>
                        </label>
                        <select name="spren" class="select select-bordered w-full" required>
                            for _, spren := range sprenList {
                                <option value={ spren }>{ spren }</option>
                            }
                        </select>
                    </div>
                    <div class="modal-action">
                        <button type="submit" class="btn btn-primary">Grant Spren</button>
                    </div>
                </form>
            }
        </div>
    </dialog>
}
