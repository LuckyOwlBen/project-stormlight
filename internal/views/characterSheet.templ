package views


import (
	"fmt"
	"project-stormlight/internal/models"
    "strconv"
	"strings"
	"project-stormlight/internal/character"
)

templ CharacterSheet(characterSheet models.CharacterSheetData) {
	
    @Layout("Character Sheet: " + characterSheet.Char.Name, true) {
		<div 
		hx-trigger="load"
		hx-ext="ws" 
		ws-connect={ "/playspace/" + strconv.Itoa(characterSheet.Char.ID) + "/ws" }
		hx-target="#notifications"
		> 
			<div class="container mx-auto p-4 max-w-6xl" id="playspace-root" data-char-id={ strconv.Itoa(characterSheet.Char.ID) }>
				<div class="flex justify-between items-center mb-6">
					<h1 class="text-4xl font-bold text-primary">{ characterSheet.Char.Name }</h1>
					<div class="badge badge-lg badge-accent">Level { strconv.Itoa(characterSheet.Char.Level) } { string(characterSheet.Char.Ancestry) }</div>
				</div>
				<div id="eventModal" hx-swap-oob="true">
					@EventModal("", nil)
				</div>
				@TalentGrantsManageModalPlaceholder()

				<!-- Playspace Navigation Tabs -->
				<div class="tabs tabs-boxed mb-6 justify-center">
					<a href={ templ.SafeURL("/playspace/" + strconv.Itoa(characterSheet.Char.ID)) } class="tab tab-active">Character Sheet</a>
					<a href={ templ.SafeURL("/playspace/" + strconv.Itoa(characterSheet.Char.ID) + "/store") } class="tab">Store</a>
				</div>
				<!-- Character Sheet Content -->
			<div class="tabs tabs-lift tabs-bottom mb-6 justify-center">
					
					//Overview Tab
					<input type="radio" name="my_tabs_5" class="tab" aria-label="Overview" checked="checked"/>
					<div class="tab-content bg-base-100 border-base-300 p-6">
						<div id="basicsComponent" hx-swap-oob="true">
							@BasicsComponent(characterSheet)
						</div>
					</div>

					//Skills Tab
					<input type="radio" name="my_tabs_5" class="tab" aria-label="Skills" />
					<div class="tab-content bg-base-100 border-base-300 p-6">
						<div id="skillsComponent" hx-swap-oob="true">
							@SkillsComponent(characterSheet)
						</div>
					</div>

					//Talents & Expertises Tab
					<input type="radio" name="my_tabs_5" class="tab" aria-label="Talents & Expertises" />
					<div class="tab-content bg-base-100 border-base-300 p-6">
						<div id="talentsComponent" hx-swap-oob="true">
							@TalentsComponent(characterSheet)
						</div>
					</div>

					<input type="radio" name="my_tabs_5" class="tab" aria-label="Equipment" />
					<div class="tab-content bg-base-100 border-base-300 p-6">
						<div id="equipmentComponent" hx-swap-oob="true">
							@EquipmentComponent(characterSheet)
						</div>
					</div>

					<input type="radio" name="my_tabs_5" class="tab" aria-label="Derived Stats" />
					<div class="tab-content bg-base-100 border-base-300 p-6">
						<div id="derivedAttributesComponent" hx-swap-oob="true">
							@DerivedAttributesComponent(characterSheet)
						</div>
					</div>

					<input type="radio" name="my_tabs_5" class="tab" aria-label="Notes" />
					<div class="tab-content bg-base-100 border-base-300 p-6">
						@NotesComponent(characterSheet.Char.SessionNotes, characterSheet.Char.ID)
					</div>

					if characterSheet.PetResources != nil {
						<input type="radio" name="my_tabs_5" class="tab" aria-label={ characterSheet.PetResources.PetName }/>
						<div class="tab-content bg-base-100 border-base-300 p-6">
							@PetStatusComponent(characterSheet.Char.ID, *characterSheet.PetResources)
						</div>
					}
				</div>
			</div>
		</div>
    }
}


templ BasicsComponent(characterSheet models.CharacterSheetData) {
	{{ char := characterSheet.Char }}
	{{ bond := character.BuildBondView(char) }}
	<div class="space-y-6">
		<div class={ "grid grid-cols-1 gap-4", templ.KV("lg:grid-cols-2", bond.Bonded) }>
			@CharacterSummaryCard(char)
			if bond.Bonded {
				@SprenBondCard(bond)
			}
		</div>
		@ResourcesComponent(char.ID, *char.Resources)
		<div>
			<h3 class="text-xs uppercase font-extrabold text-primary mb-2 tracking-wider">Defenses</h3>
			@DefensesComponent(characterSheet.DefensesMap)
		</div>
		<div>
			<h3 class="text-xs uppercase font-extrabold text-primary mb-2 tracking-wider">Attributes</h3>
			@AttributesComponent(characterSheet.AttributesMap)
		</div>
	</div>
}

templ CharacterSummaryCard(char *character.Character) {
	<div class="card bg-base-200 shadow border-t-4 border-primary">
		<div class="card-body p-4 gap-2">
			<div class="flex flex-wrap items-center justify-between gap-2">
				<h2 class="card-title text-2xl">{ char.Name }</h2>
				<div class="flex flex-wrap gap-2">
					<span class="badge badge-primary">Level { strconv.Itoa(char.Level) }</span>
					<span class="badge badge-outline">{ string(char.Ancestry) }</span>
					if char.PendingLevels > 0 {
						<span class="badge badge-warning">{ strconv.Itoa(char.PendingLevels) } level-up(s) to finalize</span>
					}
				</div>
			</div>
			if len(char.UnlockedCultureIDs) > 0 {
				<div class="text-sm">
					<span class="opacity-60">Cultures:</span>
					{ strings.Join(char.UnlockedCultureIDs, ", ") }
				</div>
			}
			if char.Ancestry == character.Singer {
				<div class="text-sm">
					<span class="opacity-60">Current form:</span>
					{ character.CurrentSingerForm(char).Name }
				</div>
			}
		</div>
	</div>
}

templ SprenBondCard(bond character.BondView) {
	<div class="card bg-base-200 shadow border-t-4 border-secondary">
		<div class="card-body p-4 gap-2">
			<div class="flex flex-wrap items-baseline justify-between gap-2">
				<span class="text-xs uppercase font-extrabold text-secondary tracking-wider">Spren Bond</span>
				<span class="font-bold">{ bond.SprenName } &middot; { bond.Order }</span>
			</div>
			<div class="text-sm">
				<span class="opacity-60">Surges:</span>
				{ bond.PrimarySurge } &middot; { bond.SecondarySurge }
			</div>
			if bond.Philosophy != "" {
				<p class="text-sm italic opacity-80">"{ bond.Philosophy }"</p>
			}
			<ul class="steps w-full mt-1">
				for _, ideal := range bond.Ideals {
					<li class={ "step", templ.KV("step-secondary", ideal.Reached) } title={ ideal.Name }>{ ideal.Label } Ideal</li>
				}
			</ul>
		</div>
	</div>
}

templ ResourcesComponent(characterId int, resources character.Resources) {
	<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
		@ValueJoinCard(resources.HealthCurrent, resources.HealthMax, "Health", "/characters/" + strconv.Itoa(characterId) + "/resources/health")
		@ValueJoinCard(resources.FocusCurrent, resources.FocusMax, "Focus", "/characters/" + strconv.Itoa(characterId) + "/resources/focus")
		if resources.InvestitureActive {
			@ValueJoinCard(resources.InvestitureCurrent, resources.InvestitureMax, "Investiture", "/characters/" + strconv.Itoa(characterId) + "/resources/investiture")
		} else {
			@UninvestedPlaceholder()
		}
	</div>
}

templ DefensesComponent(defensesMap map[string]int) {
	<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
		for _, defense := range orderedKeys(defensesMap, defenseOrder) {
			<div class="card bg-base-200 shadow border-t-4 border-primary">
				<div class="card-body p-4 text-center">
					<span class="text-xs uppercase font-extrabold text-primary">{ defense }</span>
					<span class="text-3xl font-extrabold text-base-content">{ strconv.Itoa(defensesMap[defense]) }</span>
				</div>
			</div>
		}
	</div>
}

templ AttributesComponent(attributesMap map[string]int) {
	<div class="grid grid-cols-3 md:grid-cols-6 gap-4">
		for _, attr := range orderedKeys(attributesMap, attributeOrder) {
			<div class="card bg-base-200 shadow">
				<div class="card-body p-3 text-center">
					<span class="text-xs uppercase opacity-70">{ attr }</span>
					<span class="text-2xl font-extrabold">{ strconv.Itoa(attributesMap[attr]) }</span>
				</div>
			</div>
		}
	</div>
}

templ UninvestedPlaceholder() {
	<div class="card bg-base-200 shadow border-2 border-dashed border-base-300">
		<div class="card-body p-4 text-center justify-center">
			<h2 class="card-title justify-center text-sm uppercase opacity-70">Uninvested</h2>
			<p class="text-sm opacity-60">Seek out friendship with the spren.</p>
		</div>
	</div>
}

/*
Radial progress needs --value CSS variable to work.
To change the size, use --size CSS variable which has a default value of 5rem.
To change the thickness, use --thickness CSS variable which is 10% of the size by default.

For Radial progress we need to use a div instead of the progress tag because browsers can't show text inside progress tag, and Firefox doesn’t render pseudo-elements inside progress tag at all.
Adding role="progressbar" makes it accessible to screen readers as well.
*/
templ ValueJoinCard(current int, maxValue int, label string, endpoint string) {
	<div id={ "card-" + strings.ToLower(label) } class="card bg-base-200 shadow border-t-4 border-primary">
		<div class="card-body p-4 items-center text-center gap-2">
			<h2 class="card-title text-xs uppercase font-extrabold text-primary tracking-wider">{ label }</h2>
			<div class="flex items-center gap-4">
				<button
					class="btn btn-circle btn-sm"
					aria-label={ "Decrease " + label }
					hx-post={ endpoint + "/decrement" }
					hx-target={ "#card-" + strings.ToLower(label) }
					hx-swap="outerHTML"
				>&minus;</button>
				<div
					class={ "radial-progress border-base-300 border-4 font-bold", resourceColor(label) }
					style={ "--value:" + strconv.Itoa(percentOf(current, maxValue)) + "; --size:6.5rem; --thickness:0.5rem;" }
					aria-valuenow={ strconv.Itoa(current) }
					aria-valuemax={ strconv.Itoa(maxValue) }
					role="progressbar"
				>
					{ strconv.Itoa(current) } / { strconv.Itoa(maxValue) }
				</div>
				<button
					class="btn btn-circle btn-sm"
					aria-label={ "Increase " + label }
					hx-post={ endpoint + "/increment" }
					hx-target={ "#card-" + strings.ToLower(label) }
					hx-swap="outerHTML"
				>+</button>
			</div>
		</div>
	</div>
}

templ SkillsComponent(characterSheet models.CharacterSheetData) {
	if len(characterSheet.SkillsDisplayStructure) == 0 {
		<div class="text-sm opacity-60 italic">No skills yet.</div>
	}
	<div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
		for _, spread := range characterSheet.SkillsDisplayStructure {
			@SkillComponentSection(spread)
		}
	</div>
	<div class="flex flex-wrap gap-x-6 gap-y-1 mt-4 text-xs opacity-70">
		<span class="flex items-center gap-1"><span class={ skillPipClass("bought") }></span> Rank</span>
		<span class="flex items-center gap-1"><span class={ skillPipClass("granted") }></span> Granted by a talent</span>
		<span>Hover a modifier to see how it's built.</span>
	</div>
}

templ SkillComponentSection(spread character.SkillDisplayStructure) {
	<div class={ "card bg-base-200 shadow border-t-4", templ.KV("border-secondary", spread.SpreadName == "surgeSkills"), templ.KV("border-primary", spread.SpreadName != "surgeSkills") }>
		<div class="card-body p-4 gap-2">
			<div class="flex items-baseline justify-between">
				<span class="text-xs uppercase font-extrabold text-primary tracking-wider">{ skillSpreadLabel(spread.SpreadName) }</span>
				<span class="text-xs opacity-60">{ strconv.Itoa(skillTrainedCount(spread)) } trained</span>
			</div>
			<table class="table table-sm">
				<thead>
					<tr>
						<th>Skill</th>
						<th class="hidden sm:table-cell">Attribute</th>
						<th>Rank</th>
						<th class="text-right">Mod</th>
					</tr>
				</thead>
				<tbody>
					for _, skill := range spread.Skills {
						<tr class={ templ.KV("opacity-50", !skillTrained(skill)) }>
							<td class="font-semibold">{ skillDisplayName(skill.SkillName) }</td>
							<td class="hidden sm:table-cell text-xs opacity-70">{ skill.AttributeName }</td>
							<td>
								<span class="flex gap-1" aria-label={ "Rank " + strconv.Itoa(skill.Value + skill.GrantedRank) }>
									for _, pip := range skillPips(skill) {
										<span class={ skillPipClass(pip) }></span>
									}
								</span>
							</td>
							<td class="text-right">
								<span class="tooltip tooltip-left" data-tip={ skillBreakdown(skill) }>
									<span class="text-xl font-extrabold">{ strconv.Itoa(skill.Total) }</span>
								</span>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ TalentsComponent(characterSheet models.CharacterSheetData) {
	{{ char := characterSheet.Char }}
	<div class="space-y-6">
		@BasicAttackCard(character.BuildAttacks(char))
		if char.Ancestry == character.Singer {
			<div id="singerFormsCard">
				@SingerFormsCard(characterSheet)
			</div>
		}
		for _, talentID := range reassignableGrantTalentIDs(char) {
			@TalentGrantsBox(char, talentID)
		}
		{{ sections := character.BuildTalentSections(char) }}
		if len(sections) == 0 {
			<div class="card bg-base-200 shadow border-t-4 border-primary">
				<div class="card-body p-4 text-center">
					<span class="text-xs uppercase font-extrabold text-primary">No Talents</span>
					<span class="text-sm text-secondary">This character has no talents yet.</span>
				</div>
			</div>
		}
		for _, section := range sections {
			@TalentSectionView(char.ID, section)
		}
	</div>
}

// BasicAttackCard shows the strike the character would make right now: one row per equipped
// weapon, or the unarmed strike when nothing is equipped.
templ BasicAttackCard(attacks []character.AttackView) {
	<div class="card bg-base-200 shadow border-t-4 border-error">
		<div class="card-body p-4 gap-3">
			<div class="flex items-baseline justify-between">
				<span class="text-xs uppercase font-extrabold text-error tracking-wider">Basic Attack</span>
				<span class="text-xs opacity-60">Strike</span>
			</div>
			for _, a := range attacks {
				<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 items-center">
					<div class="col-span-2 sm:col-span-1">
						<div class="font-bold">{ a.Name }</div>
						<div class="flex flex-wrap gap-1 mt-1">
							if a.Slot != "" {
								<span class="badge badge-sm badge-outline">{ a.Slot }</span>
							}
							if a.Range != "" {
								<span class="badge badge-sm badge-ghost">{ a.Range }</span>
							}
							for _, trait := range a.Traits {
								<span class="badge badge-sm badge-ghost">{ trait }</span>
							}
							for _, trait := range a.ExpertTraits {
								<span class="badge badge-sm badge-ghost opacity-60" title="Needs the matching expertise">Expert: { trait }</span>
							}
						</div>
					</div>
					<div>
						<div class="text-xs uppercase opacity-60">Attack roll</div>
						if a.HasModifier {
							<div class="text-2xl font-extrabold">{ signedInt(a.Modifier) }</div>
							<div class="text-xs opacity-60">{ skillDisplayName(a.Skill) }</div>
						} else {
							<div class="text-sm opacity-60">No { skillDisplayName(a.Skill) } skill</div>
						}
					</div>
					<div>
						<div class="text-xs uppercase opacity-60">Damage</div>
						<div class="text-2xl font-extrabold">{ a.Damage }</div>
						<div class="text-xs opacity-60">
							{ a.DamageType }
							if a.NoDieRoll {
								(no die roll)
							}
						</div>
					</div>
					if a.Unarmed {
						<div class="text-xs opacity-60 col-span-2 sm:col-span-1">No weapon equipped. Damage comes from your Strength.</div>
					}
				</div>
			}
		</div>
	</div>
}

templ TalentSectionView(charID int, section character.TalentSection) {
	<div>
		<div class="flex items-baseline gap-2 mb-2">
			<h3 class="text-lg font-bold">{ section.Title }</h3>
			<span class="text-xs opacity-60">{ strconv.Itoa(len(section.Cards)) }</span>
		</div>
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
			for _, card := range section.Cards {
				@TalentSheetCard(charID, card)
			}
		</div>
	</div>
}

// TalentSheetCard is one talent: what it costs, what it does, and every bonus it grants.
templ TalentSheetCard(charID int, card character.TalentCardView) {
	<div class={ "card bg-base-200 shadow border-t-4", templ.KV("border-success", card.Active), templ.KV("border-primary", !card.Active) }>
		<div class="card-body p-4 gap-2">
			<div class="flex items-start justify-between gap-2">
				<div class="min-w-0">
					<h4 class="font-bold">{ card.Name }</h4>
					<div class="flex flex-wrap gap-1 mt-1">
						if card.PathName != "" {
							<span class="badge badge-sm badge-ghost">{ card.PathName }</span>
						}
						for _, base := range card.Enhances {
							<span class="badge badge-sm badge-outline">Enhances { base }</span>
						}
					</div>
				</div>
				<div class="flex flex-col items-end gap-1 shrink-0">
					if card.Cost != "" {
						<span class="badge badge-primary badge-sm">{ card.Cost }</span>
					}
					if card.IsStance {
						<form hx-post="/playspace/toggle-active-stance" hx-target="#talentsComponent" hx-swap="innerHTML">
							<input type="hidden" name="id" value={ strconv.Itoa(charID) }/>
							<input type="hidden" name="activeStance" value={ card.ID }/>
							if card.Active {
								<button class="btn btn-success btn-xs" type="submit">Active</button>
							} else {
								<button class="btn btn-outline btn-xs" type="submit">Enter stance</button>
							}
						</form>
					}
				</div>
			</div>
			if card.SpecialActivation != "" {
				<p class="text-xs"><span class="font-semibold">Activation:</span> <span class="italic">{ card.SpecialActivation }</span></p>
			}
			if len(card.Effects) > 0 {
				<ul class="space-y-1">
					for _, effect := range card.Effects {
						<li class="flex items-start gap-2 text-sm">
							<span class={ effectBadgeClass(effect.Tone) }>{ effect.Label }</span>
							<span class={ effectTextClass(effect.Tone) }>{ effect.Text }</span>
						</li>
					}
				</ul>
			}
			<details class="text-xs opacity-80">
				<summary class="cursor-pointer select-none">Description</summary>
				<p class="mt-1">{ card.Description }</p>
			</details>
		</div>
	</div>
}

// skillGrantChoice pairs one resolved "choice"/"category" SkillGrant with its selectable
// options and any skills already picked, mirroring grantChoice in talents.templ.
type skillGrantChoice struct {
	GrantIndex  int
	ChoiceCount int
	Options     []character.Skill
	Selected    map[string]bool
}

// pendingSkillGrantChoices resolves the choice/category entries of an (already-aggregated)
// SkillGrant list for baseTalentID, so the management modal can render selectable options
// alongside any prior selection recorded in char.SkillGrants.
func pendingSkillGrantChoices(char *character.Character, baseTalentID string, grants []character.SkillGrant) []skillGrantChoice {
	var result []skillGrantChoice
	for i, grant := range grants {
		if grant.Type != "choice" && grant.Type != "category" {
			continue
		}
		options, err := character.ResolveSkillGrantOptions(grant)
		if err != nil {
			continue
		}
		choiceCount := grant.ChoiceCount
		if choiceCount <= 0 {
			choiceCount = 1
		}
		selected := make(map[string]bool)
		if char != nil && char.SkillGrants != nil {
			source := fmt.Sprintf("talent:%s:skill:%d", baseTalentID, i)
			for _, g := range char.SkillGrants.List {
				if g.Source == source {
					selected[g.SkillName] = true
				}
			}
		}
		result = append(result, skillGrantChoice{GrantIndex: i, ChoiceCount: choiceCount, Options: options, Selected: selected})
	}
	return result
}

// grantedSkillGrantNames returns the skill names currently granted to a character by
// baseTalentID's skill grants (e.g. Erudition's temporary skills), for badge display.
func grantedSkillGrantNames(char *character.Character, baseTalentID string) []string {
	if char == nil || char.SkillGrants == nil {
		return nil
	}
	prefix := "talent:" + baseTalentID + ":skill:"
	var names []string
	for _, g := range char.SkillGrants.List {
		if strings.HasPrefix(g.Source, prefix) {
			names = append(names, g.SkillName)
		}
	}
	return names
}

// reassignableGrantTalentIDs returns the IDs of talents this character owns that qualify
// for the generic grant-management box (own choice/category expertise or skill grants),
// e.g. "erudition" - so any future talent built the same way gets the UI automatically.
func reassignableGrantTalentIDs(char *character.Character) []string {
	if char == nil || char.Talents == nil {
		return nil
	}
	var ids []string
	for _, h := range char.Talents.List {
		if character.HasReassignableGrants(h.TalentID) {
			ids = append(ids, h.TalentID)
		}
	}
	// A Singer form with its own choice grants (Scholarform) gets the same box while active.
	if form := character.CurrentSingerForm(char); character.HasReassignableGrants(form.ID) {
		ids = append(ids, form.ID)
	}
	return ids
}

// TalentGrantsBox surfaces a base talent's temporary, reassignable expertise/skill grants
// on the live character sheet - the aggregated grant counts (from subtree talents like
// Deep Study) are only resolved when the Manage modal is opened, so this just shows current picks.
templ TalentGrantsBox(char *character.Character, talentID string) {
	<div class="card bg-base-200 shadow border-t-4 border-secondary col-span-1 md:col-span-2">
		<div class="card-body p-4">
			<div class="flex justify-between items-center">
				<span class="text-xs uppercase font-extrabold text-primary">{ character.GrantSourceName(talentID) }</span>
				<button
					type="button"
					class="btn btn-xs btn-primary"
					hx-get={ string(templ.SafeURL("/characters/" + strconv.Itoa(char.ID) + "/talents/" + talentID + "/manage-grants")) }
					hx-target="#talent-grants-manage-modal"
					hx-swap="outerHTML"
					hx-on::after-request="document.getElementById('talent-grants-manage-modal').showModal()"
				>
					Manage
				</button>
			</div>
			<p class="text-xs opacity-70 mt-1">Temporary expertise and skills granted by { character.GrantSourceName(talentID) } - reassign anytime.</p>
			<div class="flex flex-wrap gap-2 mt-2">
				for _, name := range grantedExpertiseNames(char, talentID) {
					<span class="badge badge-accent badge-sm">{ name }</span>
				}
				for _, name := range grantedSkillGrantNames(char, talentID) {
					<span class="badge badge-info badge-sm">{ name }</span>
				}
			</div>
		</div>
	</div>
}

// TalentGrantsManageModalPlaceholder is the empty dialog shell present once on the character
// sheet; GET/POST responses to /talents/{talentID}/manage-grants swap its outerHTML.
templ TalentGrantsManageModalPlaceholder() {
	<dialog id="talent-grants-manage-modal" class="modal"></dialog>
}

templ TalentGrantsManageModal(char *character.Character, talentID string, agg character.AggregatedGrants) {
	<dialog id="talent-grants-manage-modal" class="modal">
		<div class="modal-box w-11/12 max-w-3xl">
			<h3 class="font-bold text-lg">{ character.GrantSourceName(talentID) }: Manage Expertise &amp; Skills</h3>
			<form
				hx-post={ string(templ.SafeURL("/characters/" + strconv.Itoa(char.ID) + "/talents/" + talentID + "/manage-grants")) }
				hx-target="#talent-grants-manage-modal"
				hx-swap="outerHTML"
				hx-on::after-request="if(event.detail.successful) { document.getElementById('talent-grants-manage-modal').close(); }"
			>
				<h4 class="font-semibold mt-2">Expertise</h4>
				for _, grant := range pendingGrantChoices(char, character.Talent{Id: talentID, ExpertiseGrants: agg.ExpertiseGrants}) {
					<div class="mb-4">
						if grant.ChoiceCount > 1 {
							<p class="text-sm opacity-70 mb-2">Choose { strconv.Itoa(grant.ChoiceCount) }:</p>
						}
						if grant.Custom {
							<p class="text-sm opacity-70 mb-2">Enter an expertise:</p>
							for i := 0; i < grant.ChoiceCount; i++ {
								<input type="text" maxlength="60" name={ "expertiseGrant" + strconv.Itoa(grant.GrantIndex) } value={ grant.SelectedAt(i) } class="input w-full mb-2" placeholder="e.g. Ancient Languages" />
							}
						}
						<div class="grid grid-cols-1 md:grid-cols-2 gap-2">
							for _, opt := range grant.Options {
								<label class="label cursor-pointer flex justify-start gap-4">
									if grant.ChoiceCount > 1 {
										<input type="checkbox" name={ "expertiseGrant" + strconv.Itoa(grant.GrantIndex) } value={ opt.Name } class="checkbox checkbox-primary" checked?={ grant.Selected[opt.Name] } />
									} else {
										<input type="radio" name={ "expertiseGrant" + strconv.Itoa(grant.GrantIndex) } value={ opt.Name } class="radio radio-primary" checked?={ grant.Selected[opt.Name] } />
									}
									<span>{ opt.Name }</span>
								</label>
							}
						</div>
					</div>
				}
				<h4 class="font-semibold mt-4">Skills</h4>
				for _, grant := range pendingSkillGrantChoices(char, talentID, agg.SkillGrants) {
					<div class="mb-4">
						if grant.ChoiceCount > 1 {
							<p class="text-sm opacity-70 mb-2">Choose { strconv.Itoa(grant.ChoiceCount) }:</p>
						}
						<div class="grid grid-cols-1 md:grid-cols-2 gap-2">
							for _, opt := range grant.Options {
								<label class="label cursor-pointer flex justify-start gap-4">
									if grant.ChoiceCount > 1 {
										<input type="checkbox" name={ "skillGrant" + strconv.Itoa(grant.GrantIndex) } value={ opt.SkillName } class="checkbox checkbox-primary" checked?={ grant.Selected[opt.SkillName] } />
									} else {
										<input type="radio" name={ "skillGrant" + strconv.Itoa(grant.GrantIndex) } value={ opt.SkillName } class="radio radio-primary" checked?={ grant.Selected[opt.SkillName] } />
									}
									<span>{ opt.SkillName }</span>
								</label>
							}
						</div>
					</div>
				}
				<div class="modal-action">
					<button type="button" class="btn" onclick="document.getElementById('talent-grants-manage-modal').close()">Cancel</button>
					<button type="submit" class="btn btn-primary">Confirm</button>
				</div>
			</form>
		</div>
	</dialog>
}

templ EquipmentComponent(characterSheet models.CharacterSheetData) {
	{{ view := character.BuildEquipmentView(characterSheet.Char) }}
	<div class="space-y-6">
		@CarryWarnings(view)
		@CarryCapacityPanel(view.Summary)
		<div>
			<h3 class="text-lg font-bold mb-2">Equipped</h3>
			<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
				for _, slot := range view.Slots {
					@EquipSlotCard(characterSheet.Char.ID, slot)
				}
			</div>
		</div>
		if len(view.Groups) == 0 {
			<div class="text-sm opacity-60 italic">Nothing else in your pack.</div>
		}
		for _, group := range view.Groups {
			@CarriedItemsTable(characterSheet.Char.ID, group)
		}
	</div>
}

// CarryWarnings sits at the very top of the Equipment tab. Overloading never blocks anything;
// it only tells the player.
templ CarryWarnings(view character.EquipmentView) {
	if view.Summary.OverLifting {
		<div role="alert" class="alert alert-error">
			<span>
				<strong>Too heavy to lift.</strong>
				You're carrying { formatWeight(view.Summary.Carried) } lb, more than your lifting capacity of { strconv.Itoa(view.Summary.LiftingCapacity) } lb.
			</span>
		</div>
	} else if view.Summary.OverCarrying {
		<div role="alert" class="alert alert-warning">
			<span>
				<strong>Over carrying capacity.</strong>
				You're carrying { formatWeight(view.Summary.Carried) } lb, { formatWeight(view.Summary.OverBy) } lb over your carrying capacity of { strconv.Itoa(view.Summary.CarryingCapacity) } lb.
			</span>
		</div>
	}
	for _, warning := range view.Warnings {
		<div role="alert" class="alert alert-info alert-soft">
			<span>{ warning }</span>
		</div>
	}
}

templ CarryCapacityPanel(summary character.CarrySummary) {
	<div class="card bg-base-200 shadow border-t-4 border-primary">
		<div class="card-body p-4 gap-2">
			<div class="flex flex-wrap items-baseline justify-between gap-2">
				<span class="text-xs uppercase font-extrabold text-primary">Weight Carried</span>
				<span class="text-2xl font-extrabold">{ formatWeight(summary.Carried) } / { strconv.Itoa(summary.CarryingCapacity) } lb</span>
			</div>
			<progress class={ carryProgressClass(summary) } value={ progressValue(summary.Carried) } max={ strconv.Itoa(summary.CarryingCapacity) }></progress>
			<div class="flex flex-wrap gap-x-6 gap-y-1 text-sm opacity-70">
				<span>Carrying capacity: { strconv.Itoa(summary.CarryingCapacity) } lb</span>
				<span>Lifting capacity: { strconv.Itoa(summary.LiftingCapacity) } lb</span>
				<span>Equipped: { formatWeight(summary.Equipped) } lb</span>
			</div>
		</div>
	</div>
}

templ EquipSlotCard(charID int, slot character.SlotView) {
	<div class="card bg-base-200 shadow border-t-4 border-secondary">
		<div class="card-body p-4 gap-2">
			<span class="text-xs uppercase font-extrabold text-secondary">{ slot.Label }</span>
			if len(slot.Entries) == 0 {
				<span class="text-sm opacity-50 italic">Empty</span>
			}
			for _, entry := range slot.Entries {
				<div class="flex items-start justify-between gap-2">
					<div class="min-w-0">
						<div class="font-semibold">{ entry.Inv.Name }</div>
						<div class="flex flex-wrap gap-1 mt-1">
							for _, badge := range itemBadges(entry.Item) {
								<span class="badge badge-sm badge-ghost">{ badge }</span>
							}
						</div>
						if entry.Counted {
							<div class="text-xs opacity-60 mt-1">{ formatWeight(entry.TotalWeight) } lb</div>
						}
					</div>
					@EquipToggleButton(charID, entry)
				</div>
			}
		</div>
	</div>
}

templ CarriedItemsTable(charID int, group character.ItemGroup) {
	<div>
		<div class="flex items-baseline gap-2 mb-1">
			<h3 class="text-lg font-bold">{ group.Label }</h3>
			if group.Note != "" {
				<span class="text-xs opacity-60">{ group.Note }</span>
			}
		</div>
		<div class="overflow-x-auto bg-base-200 rounded-box shadow">
			<table class="table table-sm">
				<thead>
					<tr>
						<th>Item</th>
						<th>Details</th>
						<th class="text-right">Qty</th>
						<th class="text-right">Weight</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, entry := range group.Entries {
						<tr>
							<td class="font-semibold">{ entry.Inv.Name }</td>
							<td>
								<div class="flex flex-wrap gap-1">
									for _, badge := range itemBadges(entry.Item) {
										<span class="badge badge-sm badge-ghost">{ badge }</span>
									}
									if !entry.Known {
										<span class="badge badge-sm badge-warning">Unknown item</span>
									}
								</div>
							</td>
							<td class="text-right">{ strconv.Itoa(max(entry.Inv.Quantity, 1)) }</td>
							<td class="text-right">
								if entry.Counted {
									{ formatWeight(entry.TotalWeight) } lb
								} else {
									<span class="opacity-50">&mdash;</span>
								}
							</td>
							<td class="text-right">
								if entry.CanEquip {
									@EquipToggleButton(charID, entry)
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ EquipToggleButton(charID int, entry character.InventoryEntry) {
	<form
		hx-post="/playspace/toggle-equipped"
		hx-target="#equipmentComponent"
		hx-swap="innerHTML"
	>
		<input type="hidden" name="itemID" value={ strconv.Itoa(entry.Inv.ID) }/>
		<input type="hidden" name="characterID" value={ strconv.Itoa(charID) }/>
		if entry.Inv.Equipped {
			<button class="btn btn-outline btn-xs" type="submit">Unequip</button>
		} else {
			<button class="btn btn-primary btn-xs" type="submit">Equip</button>
		}
	</form>
}

templ DerivedAttributesComponent(characterSheet models.CharacterSheetData) {
	<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
		for _, attr := range sortedKeys(characterSheet.DerivedAttributes) {
			<div class="card bg-base-200 shadow border-t-4 border-primary">
				<div class="card-body p-4 text-center">
					<span class="text-xs uppercase font-extrabold text-primary">{ attr }</span>
					<span class="text-3xl font-extrabold text-base-content">{ characterSheet.DerivedAttributes[attr] }</span>
				</div>
			</div>
	}
	</div>
}

templ NotesComponent(notes string, characterID int) {
	<div id="notes-card" class="card bg-base-200 shadow border-t-4 border-primary">
		<textarea name="notes" placeholder="Session Notes" class="textarea textarea-xl"
			hx-post={ "/characters/" + strconv.Itoa(characterID) + "/session-notes" }
			hx-target="#notes-card"
			hx-trigger="keyup changed delay:1s"
			hx-swap="none">
			{ notes }
		</textarea>
	</div>
}

templ EventModal(message string, button templ.Component) {
	if message != "" {
		<div class="notification-item">
			{ message } 
			if button != nil {
				@button 
			}
		</div>
	}
}

templ HREFButton(label string, href string) {
	<a href={ templ.SafeURL(href) } class="btn btn-primary">{ label }</a>
}

templ CombatPaceSelector(characterID int) {
	<dialog id="combat-pace-selector" class="modal">
        <div class="modal-box relative max-w-2xl">
			<div class="flex justify-center space-x-4">
				<button class="btn btn-primary" 
					hx-post={ "/characters/" + strconv.Itoa(characterID) + "/combat/pace/slow" }
					hx-target="#combat-pace-selector"
					hx-swap="outerHTML">Slow</button>
				<button class="btn btn-primary" 
					hx-post={ "/characters/" + strconv.Itoa(characterID) + "/combat/pace/fast" }
					hx-target="#combat-pace-selector"
					hx-swap="outerHTML">Fast</button>
			</div>
		</div>
	</dialog>
}

templ TwoPostButtonsWithParams(label1 string, endpoint1 string, label2 string, endpoint2 string, target string, params map[string]string) {
	<div class="flex justify-center space-x-4">
		<button class="btn btn-primary" 
			hx-post={ endpoint1 }
			hx-vals={ templ.JSONString(params) }
			hx-target={ target }
			hx-swap="outerHTML">
			{ label1 }
		</button>
		<button class="btn btn-primary" 
			hx-post={ endpoint2 }
			hx-vals={ templ.JSONString(params) }
			hx-target={ target }
			hx-swap="outerHTML">
			{ label2 }
		</button>
	</div>
}

templ POSTButtonWithParams(label string, endpoint string, target string, params map[string]string) {
	<button class="btn btn-primary" 
		hx-post={ endpoint }
		hx-vals={ templ.JSONString(params) }
		hx-target={ target }
		hx-swap="outerHTML">
		{ label }
	</button>
}

templ POSTButton(label string, endpoint string, target string) {
	<button class="btn btn-primary"
		hx-post={ endpoint }
		hx-target={ target }
		hx-swap="outerHTML">
		{ label }
	</button>
}

templ ModalCloseButton(label string) {
	<button class="btn btn-primary">
		{ label }
	</button>
}