package views

import (
	"fmt"
	"strconv"
	"strings"
	"slices"
	"project-stormlight/internal/character"
)

func hasTalent(char *character.Character, talentID string) bool {
    if char == nil || char.Talents == nil {
        return false
    }
    for _, history := range char.Talents.List {
        if history.TalentID == talentID {
            return true
        }
    }
    return false
}

// grantChoice pairs one resolved "choice"/"category" ExpertiseGrant with its selectable
// options and any names already picked (so the modal can be reopened to edit a choice).
type grantChoice struct {
    GrantIndex  int
    ChoiceCount int
    Options     []character.Expertise
    Selected    map[string]bool
}

func pendingGrantChoices(char *character.Character, talent character.Talent) []grantChoice {
    var result []grantChoice
    for i, grant := range talent.ExpertiseGrants {
        if grant.Type != "choice" && grant.Type != "category" {
            continue
        }
        options, err := character.ResolveExpertiseGrantOptions(grant)
        if err != nil {
            continue
        }
        choiceCount := grant.ChoiceCount
        if choiceCount <= 0 {
            choiceCount = 1
        }
        selected := make(map[string]bool)
        if char != nil && char.Expertises != nil {
            source := fmt.Sprintf("talent:%s:%d", talent.Id, i)
            for _, e := range char.Expertises.List {
                if e.Source == source {
                    selected[e.Name] = true
                }
            }
        }
        result = append(result, grantChoice{
            GrantIndex:  i,
            ChoiceCount: choiceCount,
            Options:     options,
            Selected:    selected,
        })
    }
    return result
}

// grantedExpertiseNames returns the names of expertises already granted by this talent,
// across all of its fixed/choice/category grants, for display once resolved.
func grantedExpertiseNames(char *character.Character, talentID string) []string {
    if char == nil || char.Expertises == nil {
        return nil
    }
    prefix := "talent:" + talentID + ":"
    var names []string
    for _, e := range char.Expertises.List {
        if strings.HasPrefix(e.Source, prefix) {
            names = append(names, e.Name)
        }
    }
    return names
}

templ expertiseGrantStatus(char *character.Character, talent character.Talent) {
    for _, name := range grantedExpertiseNames(char, talent.Id) {
        <div class="mt-1 flex items-center gap-2">
            <span class="badge badge-sm badge-accent">Granted: { name }</span>
            <button
                type="button"
                class="btn btn-xs btn-ghost"
                hx-get={ string(templ.SafeURL("/characters/" + strconv.Itoa(char.ID) + "/talents/" + talent.Id + "/expertise-choice")) }
                hx-target="#talent-expertise-modal"
                hx-swap="outerHTML"
                hx-on::after-request="document.getElementById('talent-expertise-modal').showModal()"
            >Edit</button>
        </div>
    }
    if hasTalent(char, talent.Id) && character.TalentNeedsExpertiseChoice(talent) && len(grantedExpertiseNames(char, talent.Id)) == 0 {
        <div class="mt-1">
            <button
                type="button"
                class="btn btn-xs btn-warning"
                hx-get={ string(templ.SafeURL("/characters/" + strconv.Itoa(char.ID) + "/talents/" + talent.Id + "/expertise-choice")) }
                hx-target="#talent-expertise-modal"
                hx-swap="outerHTML"
                hx-on::after-request="document.getElementById('talent-expertise-modal').showModal()"
            >Choose Expertise</button>
        </div>
    }
}

templ TalentExpertiseChoiceModal(char *character.Character, talent character.Talent) {
    <dialog id="talent-expertise-modal" class="modal">
        <div class="modal-box w-11/12 max-w-3xl">
            <h3 class="font-bold text-lg">{ talent.Name }: Choose Expertise</h3>
            <form
                hx-post={ string(templ.SafeURL("/characters/" + strconv.Itoa(char.ID) + "/talents/" + talent.Id + "/expertise-choice")) }
                hx-target="#talent-expertise-modal"
                hx-swap="outerHTML"
                hx-on::after-request="if(event.detail.successful) { document.getElementById('talent-expertise-modal').close(); }"
            >
                for _, grant := range pendingGrantChoices(char, talent) {
                    <div class="mb-4">
                        if grant.ChoiceCount > 1 {
                            <p class="text-sm opacity-70 mb-2">Choose { strconv.Itoa(grant.ChoiceCount) }:</p>
                        }
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                            for _, opt := range grant.Options {
                                <label class="label cursor-pointer flex justify-start gap-4">
                                    if grant.ChoiceCount > 1 {
                                        <input type="checkbox" name={ "grant" + strconv.Itoa(grant.GrantIndex) } value={ opt.Name } class="checkbox checkbox-primary" checked?={ grant.Selected[opt.Name] } />
                                    } else {
                                        <input type="radio" name={ "grant" + strconv.Itoa(grant.GrantIndex) } value={ opt.Name } class="radio radio-primary" checked?={ grant.Selected[opt.Name] } />
                                    }
                                    <span>{ opt.Name }</span>
                                </label>
                            }
                        </div>
                    </div>
                }
                <div class="modal-action">
                    <button type="button" class="btn" onclick="document.getElementById('talent-expertise-modal').close()">Cancel</button>
                    <button type="submit" class="btn btn-primary">Confirm</button>
                </div>
            </form>
        </div>
    </dialog>
}

// isTalentFinalized reports whether an owned talent is locked (can't be removed) -
// e.g. Singer inherent talents, or any talent locked in at final character review.
func isTalentFinalized(char *character.Character, talentID string) bool {
    if char == nil || char.Talents == nil {
        return false
    }
    for _, h := range char.Talents.List {
        if h.TalentID == talentID {
            return h.Finalized
        }
    }
    return false
}

templ TalentView(char *character.Character, filteredPaths map[string]character.Path, orderedPathIDs []string, ownedPathIDs []string, activePathID string, singerQuotaMet bool) {
    <div>
        @CreationLayout(char, "talents", "Select Talents", NavState{BackEnabled: true, NextEnabled: char.Talents.PointsRemaining == 0 && singerQuotaMet}) {
            <form id="creation-form" action={ templ.SafeURL("/characters/" + strconv.Itoa(char.ID) + "/talents") } method="POST"></form>
            @talentHeader(char.Talents.PointsRemaining)
            @TalentExpertiseModalPlaceholder()
            @SingerQuotaAlert(char)
            @PathTabs(char, filteredPaths, orderedPathIDs, ownedPathIDs, activePathID)
            <div id="active-path-panel" class="card bg-base-100 shadow-xl">
                @ActivePathPanelContent(char, filteredPaths[activePathID])
            </div>
        }
    </div>
}

templ talentHeader(pointsRemaining int) {
    <div class="flex justify-between items-center mb-6">
            <div>
                <h1 class="text-3xl font-bold">Select Talents</h1>
                <p class="text-lg opacity-70 mt-1">Pick a path tab below, then purchase talents. (1 point each)</p>
            </div>
            <div class="text-xl font-semibold flex items-center gap-2">
                <span class="badge badge-info badge-lg text-lg py-4 px-4 sm:inline-flex">Points Remaining:</span>
                @PointsRemaining(pointsRemaining)
            </div>
        </div>
}

// TalentExpertiseModalPlaceholder is the empty dialog shell present once on the page;
// GET/POST responses to /talents/{talentID}/expertise-choice swap its outerHTML.
templ TalentExpertiseModalPlaceholder() {
    <dialog id="talent-expertise-modal" class="modal"></dialog>
}

templ SingerQuotaAlert(char *character.Character) {
    <div id="singer-quota-alert">
        @singerQuotaAlertContent(char)
    </div>
}

templ SingerQuotaAlertOOB(char *character.Character) {
    <div id="singer-quota-alert" hx-swap-oob="true">
        @singerQuotaAlertContent(char)
    </div>
}

templ singerQuotaAlertContent(char *character.Character) {
    if char.Ancestry == character.Singer && !character.SingerQuotaMet(char) {
        <div role="alert" class="alert alert-warning mb-6">
            <span>
                Select { strconv.Itoa(character.SingerTalentsRequiredForLevel(char.Level) - character.OwnedSingerOptionalCount(char)) } more Singer Forms talent(s) — { strconv.Itoa(character.OwnedSingerOptionalCount(char)) } of { strconv.Itoa(character.SingerTalentsRequiredForLevel(char.Level)) } selected for your level.
            </span>
        </div>
    }
}

// PathTabs renders a compact, single-row (wrapping) strip of every selectable path as a
// small tab button - a checkmark badge marks paths the character has already invested in
// (per PathsTracker), and the currently viewed path is highlighted. Only ONE path's talent
// tree is ever shown in detail at a time (in #active-path-panel below), which is what keeps
// the layout readable while still allowing talents to be picked from any number of paths.
templ PathTabs(char *character.Character, filteredPaths map[string]character.Path, orderedPathIDs []string, ownedPathIDs []string, activePathID string) {
    <div id="path-tabs" hx-swap-oob="true" class="tabs tabs-boxed mb-4 flex-wrap gap-1">
        for _, pathID := range orderedPathIDs {
            @pathTab(char.ID, filteredPaths[pathID], slices.Contains(ownedPathIDs, pathID), pathID == activePathID)
        }
    </div>
}

templ pathTab(characterId int, path character.Path, owned bool, active bool) {
    <form class="inline-block">
        <input type="hidden" name="characterId" value={ strconv.Itoa(characterId) }/>
        <input type="hidden" name="selectedPath" value={ path.ID }/>
        <button
            type="submit"
            hx-post="/characters/talents/togglePath"
            hx-include="closest form"
            hx-target="#active-path-panel"
            hx-swap="innerHTML"
            class={ "tab tab-sm sm:tab-md gap-1", templ.KV("tab-active", active) }
        >
            { path.Name }
            if owned {
                <span class="badge badge-xs badge-success" title="Talents purchased in this path"></span>
            }
        </button>
    </form>
}

// ActivePathPanelOOB re-renders the active path panel out-of-band, for responses whose
// primary hx-target is something else (e.g. the expertise-choice modal).
templ ActivePathPanelOOB(char *character.Character, path character.Path) {
    <div id="active-path-panel" hx-swap-oob="true" class="card bg-base-100 shadow-xl">
        @ActivePathPanelContent(char, path)
    </div>
}

// ActivePathPanelContent renders the single path currently being viewed - its base talent
// (if any) plus a 3-column sub-path grid, or the Singer Forms tree for "singer".
templ ActivePathPanelContent(char *character.Character, path character.Path) {
    <div class="card-body">
        if path.ID == "" {
            <p class="opacity-70">Select a path above to view its talents.</p>
        } else {
            <h2 class="card-title capitalize">{ path.Name }</h2>
            if path.ID == "singer" {
                @SingerFormsPanel(char)
            } else {
                if len(path.TalentNodes) > 0 {
                    @BaseTalentCard(char, path.ID, path.TalentNodes[0])
                }
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    for _, subPathID := range path.SubPaths {
                        <div class="col-span-1 min-w-0">
                            <h3 class="text-lg font-bold mb-2 border-b pb-1">{ character.SubPathMap[subPathID].PathName }</h3>
                            <div class="space-y-3">
                                for _, tw := range character.EvaluatePathTalents(char, path)[subPathID] {
                                    if tw.State != character.StateHidden {
                                        @TalentPathCard(char, path.ID, tw)
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
}

templ BaseTalentCard(char *character.Character, pathID string, baseTalent character.Talent) {
    <div class="card w-full bg-base-200 shadow-xl mb-6 border-2 border-primary">
        <form>
            <input type="hidden" name="characterId" value={ strconv.Itoa(char.ID) }/>
            <input type="hidden" name="selectedPath" value={ pathID }/>
            <input type="hidden" name="talentId" value={ baseTalent.Id }/>
            <div class="card-body">
                <label class="label cursor-pointer flex justify-start gap-4">
                    <input
                        type="checkbox"
                        class="checkbox checkbox-primary"
                        checked?={ hasTalent(char, baseTalent.Id) }
                        disabled?={ isTalentFinalized(char, baseTalent.Id) }
                        if !isTalentFinalized(char, baseTalent.Id) {
                            hx-post="/characters/talents/toggleTalent"
                            hx-include="closest form"
                            hx-target="#active-path-panel"
                            hx-swap="innerHTML"
                        }
                    />
                    <div>
                        <h2 class="card-title m-0 inline-block">{ baseTalent.Name } (Base Path Talent)</h2>
                        <span class="badge badge-secondary ml-2">Tier 0</span>
                    </div>
                </label>
                <p class="text-sm mt-2">{ baseTalent.Description }</p>
                @expertiseGrantStatus(char, baseTalent)
            </div>
        </form>
    </div>
}

templ TalentPathCard(char *character.Character, pathID string, tw character.TalentWithState) {
    <div class={ "card shadow-md border border-base-300 bg-base-100 min-w-0", templ.KV("opacity-50", tw.State == character.StateIneligible && !hasTalent(char, tw.Talent.Id)) }>
        <form>
            <input type="hidden" name="characterId" value={ strconv.Itoa(char.ID) }/>
            <input type="hidden" name="selectedPath" value={ pathID }/>
            <input type="hidden" name="talentId" value={ tw.Talent.Id }/>
            <label class="label flex justify-start gap-4 p-4 cursor-pointer">
                <input
                    type="checkbox"
                    class="checkbox checkbox-primary checkbox-sm"
                    checked?={ hasTalent(char, tw.Talent.Id) }
                    disabled?={ isTalentFinalized(char, tw.Talent.Id) || (tw.State == character.StateIneligible && !hasTalent(char, tw.Talent.Id)) }
                    if !isTalentFinalized(char, tw.Talent.Id) {
                        hx-post="/characters/talents/toggleTalent"
                        hx-include="closest form"
                        hx-target="#active-path-panel"
                        hx-swap="innerHTML"
                    }
                />
                <div>
                    <h4 class="font-bold m-0">{ tw.Talent.Name }</h4>
                    <span class="badge badge-sm badge-secondary">Tier { strconv.Itoa(tw.Talent.Tier) }</span>
                    if tw.Talent.ActionType != "" {
                        <span class="badge badge-sm badge-ghost ml-1">{ tw.Talent.ActionType }</span>
                    }
                </div>
            </label>
            <p class="text-xs px-4 pb-2 opacity-80">{ tw.Talent.Description }</p>
            if tw.State == character.StateIneligible && !hasTalent(char, tw.Talent.Id) {
                <div class="px-4 pb-3">
                    <p class="text-xs text-warning font-semibold">Prerequisites not met:</p>
                    <ul class="text-xs text-warning opacity-80 list-disc list-inside">
                        for _, req := range tw.UnmetPrereqs {
                            <li>{ req }</li>
                        }
                    </ul>
                </div>
            }
            @expertiseGrantStatus(char, tw.Talent)
        </form>
    </div>
}

// SingerFormsPanel renders the Singer Forms talent tree for the "singer" pseudo-path: the
// two inherent ancestry talents (auto-granted, not purchasable) plus the optional forms
// pool, gated only by each talent's own prerequisites (no tier-reveal).
templ SingerFormsPanel(char *character.Character) {
    <div class="card w-full bg-base-200 shadow-xl mb-6 border-2 border-primary">
        <div class="card-body">
            <h2 class="card-title m-0">Inherent Forms</h2>
            <p class="text-xs opacity-70 mb-2">Granted automatically to every Singer — free, no points spent.</p>
            for _, id := range []string{"singer_ancestry", "singer_change_form"} {
                if t, ok := character.SingerTalents[id]; ok {
                    <div class="mb-2">
                        <span class="badge badge-accent">{ t.Name }</span>
                        <p class="text-xs mt-1 opacity-80">{ t.Description }</p>
                    </div>
                }
            }
        </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        for _, tw := range character.EvaluateSingerOptionalTalents(char, nil) {
            @TalentPathCard(char, "singer", tw)
        }
    </div>
}
